# Runtime
ENVIRONMENT=development
AUTO_CREATE_SCHEMA=true
DATABASE_URL=sqlite:///./leads.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional operator authentication (enabled only when both values are set)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# SMTP (seal these values in Railway production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SENDER_NAME=LeadPulse AI
SENDER_EMAIL=contact@example.com
SENDER_PHONE=+441234567890

# Non-secret application settings
AGENCY_NAME=LeadPulse AI
CALENDLY_URL=https://calendly.com/your-account/intro
DEMO_INBOUND_PHONE=+441234567890
DEFAULT_SETUP_PRICE=1250 EUR
DEFAULT_RETAINER_PRICE=450 EUR/month

# Twilio (prefer restricted API keys in production)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM_PHONE=

# Vapi is reserved for a future real integration; no calls are simulated.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
